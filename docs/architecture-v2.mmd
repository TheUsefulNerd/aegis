%% AEGIS pipeline as BUILT (updated 2026-09-25). Companion to
%% architecture-document-2page.md; step numbers match that document.
%% Dashed grey boxes are designed-not-built roadmap items, shown so the
%% diagram never implies more than exists.

flowchart TD

    F0[/"Config file(s) - single or bulk upload<br/>CLI text / XML / JSON, any vendor"/]

    F0 --> S1["1. Redaction pass (runs first)<br/>typed placeholders for passwords, hashes, SNMP,<br/>PSKs, RADIUS/TACACS+, routing keys, XML/JSON secrets<br/>originals never stored or sent to an AI"]

    S1 --> S2A["2a. Fingerprint<br/>vendor + format + confidence<br/>unknown vendor = still processed"]
    S1 --> S2B["2b. Device identity<br/>hostname / model / serial / firmware"]

    S2A --> SPLIT["Split into units<br/>CLI lines / XML paths / JSON paths"]

    SPLIT --> GATE{"3. Input-sanity gate<br/>text shaped like an instruction to an AI?"}
    GATE -- "yes: blocked BEFORE any LLM call" --> Q

    GATE -- "no" --> KB{{"4. resolve_unit - ONE function, ONE knowledge base"}}

    KB -- "Tier 1: exact / regex KB match<br/>instant, deterministic" --> NORM
    KB -- "no match" --> LLM["Tier 2: LLM (Groq, Gemini fallback)<br/>proposes field + value + confidence<br/>validated: known field, confidence 0-1,<br/>value type matches field kind"]
    LLM -- "valid and confidence >= 0.6" --> NORM
    LLM -- "rejected / low confidence / unavailable" --> Q

    Q[["Tier 3: Review queue<br/>blocked attacks flagged red, sorted first<br/>reviewer confirms field + value<br/>+ security-relevant? + auditor notes"]]
    Q -- "confirmation = new Tier-1 pattern<br/>(no redeploy)" --> KBW[("Knowledge base<br/>per vendor, provenance-tracked")]
    KBW -. "next device: instant Tier-1 hit" .-> KB

    NORM["5. Canonical Security Baseline Model<br/>NIST 800-53 families AC / AU / IA / SC / CM<br/>per-field provenance (KB entry, tier, source line)"]
    S2B --> RPT

    NORM --> RULE["6. Deterministic rule engine (no LLM)<br/>39 cited rules: CIS / NIST / STIG / ISO<br/>6 predicate types incl. ordered first-match ACL<br/>vendor-specific benchmarks scoped to their vendor"]

    RULE --> VERDICT{"Finding"}
    VERDICT -->|"setting found"| PF["PASS / FAIL + severity"]
    VERDICT -->|"setting never mentioned"| NE["NOT_EVALUATED<br/>(never a silent PASS)"]

    PF --> REM["7. Remediation<br/>vetted per-vendor templates only<br/>never AI-generated"]
    NE --> RPT
    REM --> RPT["8. Per-device PDF<br/>device ID + executive summary + legend<br/>findings most-urgent first + source of each decision"]

    OBS[["Langfuse: every LLM call traced,<br/>human decision scored on the same trace"]]
    LLM -.-> OBS
    Q -.-> OBS

    XREF["Roadmap: cross-reference stage<br/>(join settings split across lines by name)"]
    XREF -.- SPLIT

    classDef redact fill:#4BACC6,stroke:#2f8a9e,color:#fff
    classDef gate fill:#C0504D,stroke:#8f3a36,color:#fff
    classDef resolve fill:#8064A2,stroke:#5f4a7d,color:#fff
    classDef norm fill:#4F81BD,stroke:#2f5c8a,color:#fff
    classDef rule fill:#1F497D,stroke:#12305a,color:#fff
    classDef remediate fill:#F79646,stroke:#c9761c,color:#fff
    classDef report fill:#9BBB59,stroke:#77953f,color:#fff
    classDef unknown fill:#7F7F7F,stroke:#595959,color:#fff
    classDef obs fill:#F2F2F2,stroke:#999,color:#333,stroke-dasharray: 4 3
    classDef roadmap fill:#FFFFFF,stroke:#999,color:#777,stroke-dasharray: 4 3

    class S1,S2A,S2B,SPLIT redact
    class GATE gate
    class KB,LLM,Q,KBW resolve
    class NORM norm
    class RULE,VERDICT,PF rule
    class NE unknown
    class REM remediate
    class RPT report
    class OBS obs
    class XREF roadmap
